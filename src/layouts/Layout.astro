---
import "../styles/global.css";

interface Props {
	title?: string;
	favicon?: string;
}

const { 
	title = "Veterinaria - Cuidado Profesional", 
	favicon = "/favicon.svg" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			:root {
				--color-primary: #007bff; /* primary color */
				--color-accent: #6c757d; /* secondary color */
			}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
